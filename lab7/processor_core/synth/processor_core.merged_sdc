  [get_clocks tessent_tck]  \
  [get_clocks bap1_tck]  \
  [get_clocks bap1_interfaces_tck] ]
set_clock_gating_check -setup 0.0 
set_input_delay -clock [get_clocks tessent_tck] -clock_fall -add_delay 20.0 [get_ports ijtag_ce]
set_input_delay -clock [get_clocks tessent_tck] -clock_fall -add_delay 20.0 [get_ports ijtag_se]
set_input_delay -clock [get_clocks tessent_tck] -add_delay 20.0 [get_ports ijtag_ue]

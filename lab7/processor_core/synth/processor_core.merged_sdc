set_input_delay -clock [get_clocks tessent_tck] -clock_fall -add_delay 20.0 [get_ports ijtag_si]
set_output_delay -clock [get_clocks tessent_tck] -add_delay 20.0 [get_ports ijtag_so]
set_disable_timing -from S0 -to Y [get_cells DATA_MEM_1_interface_inst/tessent_persistent_cell_BIST_CLK_OR_TCK]
set_disable_timing -from S0 -to Y [get_cells PROG_MEM_2_interface_inst/tessent_persistent_cell_BIST_CLK_OR_TCK]

@file(mbist_postelab.tcl) 63: set sb_mods [vfind . -subdesign *_tessent_mbist_*_shared_bus_assembly]
@file(mbist_postelab.tcl) 64: set sb_insts [get_db $sb_mods .instance]
@file(mbist_postelab.tcl) 65: foreach sb_inst $sb_insts {
  # ungroup everything in the assembly but the controller
  ungroup [get_db $sb_inst -depth {1 1} -invert -if \
   {.module =~ *_tessent_mbist_*_controller}]
}

module test_control(m_rcc_clk, m_digit_clk, m_spi_clk, m_ram_clk,
     m_dsram_clk, m_clk, clk, rcc_clk, digit_clk, spi_clk, ram_clk,
     dsram_clk, scan_clk, test_mode);

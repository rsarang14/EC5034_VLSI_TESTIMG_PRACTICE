  wire n_0, n_1, n_2, n_3, n_4;
  assign m_clk = m_ram_clk;
  assign m_dsram_clk = m_ram_clk;
  clock_inv01 g33(.A (rcc_clk), .Y (n_3));
  clock_inv01 g35(.A (clk), .Y (n_2));
  clock_inv01 g34(.A (spi_clk), .Y (n_1));
  clock_inv01 g36(.A (digit_clk), .Y (n_0));
  oai21 g42(.A0 (test_mode), .A1 (n_3), .B0 (n_4), .Y (m_rcc_clk));
  nand02 g31(.A0 (test_mode), .A1 (scan_clk), .Y (n_4));
  oai21 g70(.A0 (test_mode), .A1 (n_0), .B0 (n_4), .Y (m_digit_clk));
  oai21 g71(.A0 (n_2), .A1 (test_mode), .B0 (n_4), .Y (m_ram_clk));
  oai21 g72(.A0 (n_1), .A1 (test_mode), .B0 (n_4), .Y (m_spi_clk));
endmodule


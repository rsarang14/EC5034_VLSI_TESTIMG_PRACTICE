#!/bin/sh
unset noclobber
xitval=0

if [ -f ./questa.setup_script ] ; then
  . ./questa.setup_script
fi

echo "Number of expected miscompares = 0"
set -v


vlib dut_work
vmap dut_work dut_work


# Entry 1
vlog -work dut_work -L dut_work -mixedansiports +librescan  -ysearchlib -mfcu \
      -f file_lists/questa.list_1 \
      -f questa.arguments_1
if [ $? != 0 ] ; then xitval=-1; echo "Failure on entry 1"; fi

# Entry 2
vlog -work dut_work -L dut_work -mixedansiports +librescan  -ysearchlib -mfcu \
      "../../../tsdb_outdir/instruments/dtmf_recvr_core_rtl1_ijtag.instrument/dtmf_recvr_core_rtl1_tessent_sib_1.v" \
      "../../../tsdb_outdir/instruments/dtmf_recvr_core_rtl1_ijtag.instrument/dtmf_recvr_core_rtl1_tessent_sib_2.v" \
      "../../../tsdb_outdir/instruments/dtmf_recvr_core_rtl1_ijtag.instrument/dtmf_recvr_core_rtl1_tessent_sib_3.v" \
      "../../../tsdb_outdir/instruments/dtmf_recvr_core_rtl1_ijtag.instrument/dtmf_recvr_core_rtl1_tessent_sib_4.v" \
      "../../../tsdb_outdir/instruments/dtmf_recvr_core_rtl1_ijtag.instrument/dtmf_recvr_core_rtl1_tessent_tdr_sri_ctrl.v" \
      -f questa.arguments_1
if [ $? != 0 ] ; then xitval=-1; echo "Failure on entry 2"; fi

# Entry 3
vlog -work dut_work -L dut_work -mixedansiports +librescan  -ysearchlib -mfcu \
      -f file_lists/questa.list_2 \
      -f questa.arguments_1
if [ $? != 0 ] ; then xitval=-1; echo "Failure on entry 3"; fi

# Entry 4
vlog -work dut_work -L dut_work -mixedansiports +librescan  -ysearchlib -mfcu \
      "./patterns_directory/MemoryBist_ParallelRetentionTest_P1.v" \
      -f questa.arguments_1
if [ $? != 0 ] ; then xitval=-1; echo "Failure on entry 4"; fi

# Entry 5
vlog -work dut_work -L dut_work -mixedansiports +librescan  -ysearchlib -mfcu \
      "./patterns.configuration"
if [ $? != 0 ] ; then xitval=-1; echo "Failure on entry 5"; fi

if [ $xitval -ne 0 ]; then
  echo "Compilation failed"
  exit $xitval
fi

vsim -c -lib "dut_work" -L dut_work -do 'log -r /*;run -all; exit' -voptargs="+acc" +nowarnTFMPC +NEWPATH=./patterns_directory \
      MemoryBist_ParallelRetentionTest_P1_configuration
if [ $? != 0 ] ; then xitval=-1; fi

if [ $xitval -ne 0 ]; then
  echo "Simulation failed"
fi

exit $xitval
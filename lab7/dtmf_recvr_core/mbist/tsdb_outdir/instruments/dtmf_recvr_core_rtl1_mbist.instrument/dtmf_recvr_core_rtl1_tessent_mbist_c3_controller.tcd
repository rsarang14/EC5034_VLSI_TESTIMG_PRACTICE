Core(dtmf_recvr_core_rtl1_tessent_mbist_c3_controller) {    
    MemoryBistController {
        Version         : 58;
        ControllerType  : HardProgrammable;
        use_multicycle_paths  : ON;
        asynchronous_interface_present : "off";
        NumberOfInstructions    : 0;
        NumberOfDataRegisterBits: 2;
        ConnectionInfo { 
            SerialInterface     : ON;
            MemoryReset         : Off;
            UseAsyncReset       : Off;
            ParallelRetentionTest   : Always;
            CompStatAllowed : Off;
            FailureLimit    : 0;
            StopOnErrorLimitAutoIncrement    : OFF;
            DaisyChain      : ON;
            CompStatIDMuxing    : Never;
        } 
        FreezeTestPortAllowed   : Off;
        controller_flop_count  : 60;
        interface_flop_count   : 31;
        RedundancyAnalysis  : Off;
        SelfRepair          : Off;
        ErrorCollectionAllowed  : Off;
        SOEOptimizeVersion          : 1;
        SOEWithCompStatMuxAllowed   : Off;
        ROMDiagnostic             : Off;
        FunctionalDebugMode       : Off;
        enable_resume_diagnosis   : OFF;
        PSRTWithFreezeStepAllowed   : Off;
        PSRTGroup   : On;
        CompStatConnectionTest  : Off;
        SelectiveParallelMemoryTest : On;
        EnableAddressSegmentX0Y0    : Off;
        SoftAlgorithmAddressMinMax  : Off;
        SharedAddressRegisters : Off;
        PipelineControllerOutputs : Off;
        StopOnErrorLimitAutoIncrement : Off;
      
        AllowCommonAlgorithmForStepRange    : On;
        AllowCommonOperationSetForStepRange : On;
        AllowCommonDataPatternForStepRange  : On;
        ParallelRetentionTest   : OFF;
        CounterA                : 0;
        DelayCounter            : 0;
        EnableAEqualsBCommand   : OFF;
        DataPolarityPresent     : 0;
        InvertDataWithAddressBitRange : 0;
        ColumnBits              : 4;
        RowBits                 : 5;
        BankBits                : 0;
        MaxX0Bits               : 0;
        MaxY0Bits               : 0;
        RomBist                 : On;
        RamBist                 : Off;
        RomSignatureLocation : EXTERNALSTRAPS;
        HSDLNames {
            InstructionPointer  : %BP%_INST_POINTER_REG[1:0];
            RepeatLoopACounter  : %BP%_REPEATLOOP_A_CNTR_REG[1:0];
            RepeatLoopBCounter  : %BP%_REPEATLOOP_B_CNTR_REG[1:0];
            OperationCycleCounter : %BP%_JCNT[2:0];
        }
        AddressRegister ( A ) {
                HSDLName(Row,4,0)   : %BP%_A_ADD_REG_X[4:0];
                HSDLName(Column,3,0) : %BP%_A_ADD_REG_Y[3:0];
        } 
        AddressRegister ( B ) {
                HSDLName(Row,4,0)   : %BP%_B_ADD_REG_X[4:0];
                HSDLName(Column,3,0) : %BP%_B_ADD_REG_Y[3:0];
        } 
        StepCounter ( 0 ) { 
            MemoryContentValue  : 2'b00;
            DefaultAlgorithm    : READONLY;
            DefaultOperationSet : ROM;
            DefaultRunTime(All) : 2054; 
            DefaultRunTime(All_Approximated) : 2066.0;
            DefaultRunTime(StartToPause) : 2066.0;
            DefaultRunTime(PauseToPause) : 2066.0;
            DefaultRunTime(PauseToEnd) : 2066.0;
            DefaultRunTime(StartToPauseReducedAddressCount) : 2066.0;
            DefaultRunTime(PauseToPauseReducedAddressCount) : 2066.0;
            DefaultRunTime(PauseToEndReducedAddressCount) : 2066.0;
            DefaultRunTime(ReducedAddressCount) : 2066.0;
            DefaultRunTime(MemoryReset) : 2066.0;
            NumPorts    : 1;
            SameAddressRange  : On;
            Latency     : 0;
            Address(Row) {
                AddressBits     : 5;
                DefaultMin      : 0;
                DefaultMax      : 31;
            }
            Address(Column) {
                AddressBits     : 4;
                DefaultMin      : 0;
                DefaultMax      : 15;
            }
            MemoryCollar        : M1;
        } 
        MemoryCollar ( m1 ) { 
            MemoryModuleName    : rom_512x16A;
            MemoryIDIndex         : 0;
            MemoryTemplate        : rom_512x16A;
            LogicalPorts          : 1R;
            NumPorts              : 1;
            milliwatts_per_mhz    : 1.2;
            number_of_words       : 512;
            BitGrouping         : 1;
            PipelineDepth       : 0;
            NumberOfBistDataPipelineStages : 0;
            Latency             : 2;
            MisrSegmentCount	: 1;
            MisrSegment ( 0 ) {
              size	: 24;
              taps 	: 0,1,3,4;
            }
            Address(Row) {
                DefaultMin      : 0;
                DefaultMax      : 31;
            }
            Address(Column) {
                DefaultMin      : 0;
                DefaultMax      : 15;
            }
           RomContentFile  : "romcontent.cfg";
            PortCounter ( 0 ) {
                Misr            : %BP%_m1_PORT0_MISR_REG[23:0];
                Port(Read) {
                    Map(Data) {
                      Equations {
                        Q[15]  : (d(15));
                        Q[14]  : (d(14));
                        Q[13]  : (d(13));
                        Q[12]  : (d(12));
                        Q[11]  : (d(11));
                        Q[10]  : (d(10));
                        Q[9]  : (d(9));
                        Q[8]  : (d(8));
                        Q[7]  : (d(7));
                        Q[6]  : (d(6));
                        Q[5]  : (d(5));
                        Q[4]  : (d(4));
                        Q[3]  : (d(3));
                        Q[2]  : (d(2));
                        Q[1]  : (d(1));
                        Q[0]  : (d(0));
                      } 
                    } 
                    Map(ComplexAddress) {
                      Equations {
                        RowAddress[0]    : (r(0));
                        RowAddress[1]    : (r(1));
                        RowAddress[2]    : (r(2));
                        RowAddress[3]    : (r(3));
                        RowAddress[4]    : (r(4));
                        ColumnAddress[0] : (c(0));
                        ColumnAddress[1] : (c(1));
                        ColumnAddress[2] : (c(2));
                        ColumnAddress[3] : (c(3));
                      }
                    }
                    Map(AddressPort) {
                      Equations {
                        RowAddress[4]    : A[8];
                        RowAddress[3]    : A[7];
                        RowAddress[2]    : A[6];
                        RowAddress[1]    : A[5];
                        RowAddress[0]    : A[4];
                        ColumnAddress[3] : A[3];
                        ColumnAddress[2] : A[2];
                        ColumnAddress[1] : A[1];
                        ColumnAddress[0] : A[0];
                      } 
                    } 
                } 
            } 
        } 
        Algorithm ( READONLY ) { 
            Type        : IC; 
            AllowMultiSizeMemParallelTest   : ON;
            TargetMemory                    : ALLCOMPATIBLE;
            TreatBankAsRowMSB               : OFF;
            TestRegisterSetup { 
                AddressGenerator {
                    AddressRegister ( A ) {
                        LoadRowAddress      : 5'b00000;
                        LoadColumnAddress   : 4'b0000;
                        NumberX0Bits        : 0; 
                        NumberY0Bits        : 0; 
                        ZCarryIn     : None; 
                        X1CarryIn     : Y1CARRYOUT;
                        X0CarryIn     : None; 
                        Y1CarryIn     : NONE;
                        Y0CarryIn     : None; 
                    } 
                    AddressRegister ( B ) {
                        LoadRowAddress      : 5'b00000;
                        LoadColumnAddress   : 4'b0000;
                        NumberX0Bits        : 0; 
                        NumberY0Bits        : 0; 
                        ZCarryIn     : None; 
                        X1CarryIn     : NONE;
                        X0CarryIn     : None; 
                        Y1CarryIn     : X1CARRYOUT;
                        Y0CarryIn     : None; 
                    } 
                } 
                DataGenerator {
                    LoadWriteData           : 2'b00;
                    LoadExpectData          : 2'b00;
                    InvertDataWithRowBit    : None;
                    InvertDataWithColumnBit : None;
                } 
                LoadCounterA_EndCount       : 0;
                LoadDelayCounter_EndCount   : 0; 
                OperationSetSelect          : ROM; 
            } 
            MicroProgram { 
                Instruction ( NOOPERATION ) { 
                    ApplyToBitSlice         : On;
                    CheckerBoard            : Off; 
                    DisableMemoriesWithoutWriteEnable      : Off;
                    DisableMemoriesWithoutGroupWriteEnable : Off;
                    DisableMemoriesWithoutReadEnable       : Off;
                    DisableMemoriesWithoutOutputEnable     : Off;
                    DisableMemoriesWithoutSelect           : Off;
                    Add_Reg_A_Equals_B      : Off;
                    AddressSelectCmd        : Select_A;
                    BranchToInstruction     : NOOPERATION;
                    CounterACmd             : Hold;
                    DelayCounterCmd         : Hold; 
                    ExpectDataCmd           : Zero;
                    InhibitDataCompare      : Off;
                    InhibitLastAddressCount : Off;
                    InhibitRefresh          : Off; 
                    OperationSelect         : NOOPERATION;
                    WriteDataCmd            : Zero;
                    ZAddressCmd      : Hold; 
                    X1AddressCmd      : Hold;
                    X0AddressCmd      : Hold; 
                    Y1AddressCmd      : Hold;
                    Y0AddressCmd      : Hold; 
                    NextConditions {
                        Z_EndCount : Off; 
                        X1_EndCount : Off;
                        X0_EndCount : Off; 
                        Y1_EndCount : Off;
                        Y0_EndCount : Off; 
                        CounterAEndCount        : Off;
                        DelayCounterEndCount    : Off; 
                    } 
                } 
                Instruction ( READ ) { 
                    ApplyToBitSlice         : On;
                    CheckerBoard            : Off; 
                    DisableMemoriesWithoutWriteEnable      : Off;
                    DisableMemoriesWithoutGroupWriteEnable : Off;
                    DisableMemoriesWithoutReadEnable       : Off;
                    DisableMemoriesWithoutOutputEnable     : Off;
                    DisableMemoriesWithoutSelect           : Off;
                    Add_Reg_A_Equals_B      : Off;
                    AddressSelectCmd        : Select_A;
                    BranchToInstruction     : READ;
                    CounterACmd             : Hold;
                    DelayCounterCmd         : Hold; 
                    ExpectDataCmd           : Zero;
                    InhibitDataCompare      : Off;
                    InhibitLastAddressCount : On;
                    InhibitRefresh          : Off; 
                    OperationSelect         : READ;
                    WriteDataCmd            : Zero;
                    ZAddressCmd      : Hold; 
                    X1AddressCmd      : Increment;
                    X0AddressCmd      : Hold; 
                    Y1AddressCmd      : Increment;
                    Y0AddressCmd      : Hold; 
                    NextConditions {
                        Z_EndCount : Off; 
                        X1_EndCount : On;
                        X0_EndCount : Off; 
                        Y1_EndCount : On;
                        Y0_EndCount : Off; 
                        CounterAEndCount        : Off;
                        DelayCounterEndCount    : Off; 
                        RepeatLoop ( A ) {
                            BranchToInstruction         : READ;
                            Repeat {
                                AddressSequence         : Inverse;
                                WriteDataSequence       : NoChange;
                                ExpectDataSequence      : NoChange;
                                InhibitLastAddressCount : On;
                                InhibitDataCompare      : Off;
                            }
                        }
                    } 
                } 
                Instruction ( COMPAREMISR ) { 
                    ApplyToBitSlice         : On;
                    CheckerBoard            : Off; 
                    DisableMemoriesWithoutWriteEnable      : Off;
                    DisableMemoriesWithoutGroupWriteEnable : Off;
                    DisableMemoriesWithoutReadEnable       : Off;
                    DisableMemoriesWithoutOutputEnable     : Off;
                    DisableMemoriesWithoutSelect           : Off;
                    Add_Reg_A_Equals_B      : Off;
                    AddressSelectCmd        : Select_A;
                    BranchToInstruction     : COMPAREMISR;
                    CounterACmd             : Hold;
                    DelayCounterCmd         : Hold; 
                    ExpectDataCmd           : Zero;
                    InhibitDataCompare      : Off;
                    InhibitLastAddressCount : Off;
                    InhibitRefresh          : Off; 
                    OperationSelect         : COMPAREMISR;
                    WriteDataCmd            : Zero;
                    ZAddressCmd      : Hold; 
                    X1AddressCmd      : Hold;
                    X0AddressCmd      : Hold; 
                    Y1AddressCmd      : Hold;
                    Y0AddressCmd      : Hold; 

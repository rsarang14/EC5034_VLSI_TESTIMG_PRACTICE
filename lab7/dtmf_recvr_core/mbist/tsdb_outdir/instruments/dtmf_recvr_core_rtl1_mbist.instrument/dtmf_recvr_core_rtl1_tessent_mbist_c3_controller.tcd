                        Z_EndCount : Off; 
                        X1_EndCount : Off;
                        X0_EndCount : Off; 
                        Y1_EndCount : Off;
                        Y0_EndCount : Off; 
                        CounterAEndCount        : Off;
                        DelayCounterEndCount    : Off; 
                    } 
                } 
            } 

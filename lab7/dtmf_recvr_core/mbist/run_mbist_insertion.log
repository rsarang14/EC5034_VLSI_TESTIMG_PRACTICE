//  command: report_config_data 

DefaultsSpecification(user) {
}
DftSpecification(dtmf_recvr_core,rtl1) {
  IjtagNetwork {
    HostScanInterface(ijtag) {
      Sib(sri) {
        Attributes {
          tessent_dft_function : scan_resource_instrument_host;
        }
        Sib(sri_ctrl) {
          Tdr(sri_ctrl) {
            Attributes {
              tessent_dft_function : scan_resource_instrument_dft_control;
            }
          }
        }
      }
      Sib(sti) {
        Attributes {
          tessent_dft_function : scan_tested_instrument_host;
        }
        Sib(mbist) {
        }
      }
    }
  }
  MemoryBist {
    ijtag_host_interface : Sib(mbist);
    Controller(c1) {
      clock_domain_label : m_ram_clk;
      Step {
        MemoryInterface(m1) {
          instance_name : RAM_128x16_TEST_INST/RAM_128x16_INST;
        }
      }
    }
    Controller(c2) {
      clock_domain_label : m_dsram_clk;
      Step {
        MemoryInterface(m1) {
          instance_name : RAM_256x16_TEST_INST_1/RAM_256x16_INST;
        }
        ReusedMemoryInterface(m2) {
          instance_name : RAM_256x16_TEST_INST_2/RAM_256x16_INST;
          reused_interface_id : m1;
        }
        ReusedMemoryInterface(m3) {
          instance_name : RAM_256x16_TEST_INST_3/RAM_256x16_INST;
          reused_interface_id : m1;
        }
      }
    }
    Controller(c3) {
      clock_domain_label : m_clk;
      Step {
        MemoryInterface(m1) {
          instance_name : ROM_512x16_0_INST;
          rom_content_file : <path_to_rom_content_file>;
        }
      }
    }
  }
}

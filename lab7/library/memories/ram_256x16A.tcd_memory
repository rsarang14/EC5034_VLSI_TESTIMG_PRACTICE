MemoryTemplate (ram_256x16A) {

   MemoryType      : SRAM;
   CellName        : ram_256x16A;
   Algorithm       : SMarchCHKBCil;
   transparentMode : SyncMux;
   logicalPorts    : 1rw;
   MinHold         : 2;
   NumberOfWords   : 256;
   MilliWattsPerMegaHertz : 1.2;
   DataOutStage    : None;
      Port (CLK)  {
                    Function    : Clock;
                    Polarity    : ActiveHigh;
      } 
      Port (WEN) {  
                    Function    : WriteEnable; 
                    Polarity    : ActiveLow; 
      } 
      Port (D[15:0]) { 
                    Function    : Data; 
                    Direction   : Input; 
      }
      Port (Q[15:0]) { 
                    Function    : Data; 
                    Direction   : Output; 
      }
      port (A[7:0]) {
                    function    : Address;
      }
      port (CEN) {
                    function    : Select;
                    Polarity    : ActiveLow; 
      }

      AddressCounter {
           Function (Address) {
               LogicalAddressMap {
                   RowAddress[3:0]    : Address [7:4];
                   ColumnAddress[3:0] : Address [3:0];  
               }
           }
      }

     OperationSet : sync;

}

library("adk_typ") {
   delay_model : table_lookup;
   date : "Friday March 03, 2017";
   comment : "vendor : Mentor Graphics ";
   time_unit : "1ns";
   voltage_unit : "1V";
   current_unit : "1mA";
   capacitive_load_unit ( 1, pf ) ;
   pulling_resistance_unit : "1ohm"; 
   nom_process : 1.0 ;
/*   nom_temperature : 27 ; */ /* Defined by operating_conditions */
   nom_voltage : 1.8 ;

   default_output_pin_cap : 0.0 ;
   default_inout_pin_cap : 1.0 ;
   default_input_pin_cap : 1.0 ;
   default_fanout_load : 1.0 ;
   default_max_fanout : 10.0 ;
   default_max_transition : 15.0 ; 
   default_cell_leakage_power : 0.0 ;
   leakage_power_unit : "1pW" ;
   default_leakage_power_density : 0.00159 ;

   slew_lower_threshold_pct_rise : 10.0 ;
   slew_lower_threshold_pct_fall : 80.0 ;
   slew_upper_threshold_pct_rise : 20.0 ;
   slew_upper_threshold_pct_fall : 90.0 ;
   input_threshold_pct_rise : 10.0 ;
   input_threshold_pct_fall : 90.0 ;
   output_threshold_pct_rise : 10.0 ;
   output_threshold_pct_fall : 90.0;

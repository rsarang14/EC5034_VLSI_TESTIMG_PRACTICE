  default_fanout_load	: 1.0;
  default_output_pin_cap	: 0.0;
  default_inout_pin_cap	: 0.00158;
  default_input_pin_cap	: 0.00158;
  default_max_transition	: 2.4;

  /* templates */
  lu_table_template(delay_template_7x1) {

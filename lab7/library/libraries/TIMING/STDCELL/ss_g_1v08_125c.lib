    pin(SI) {
      direction : input;
      signal_type : test_scan_in;
    }
    pin(SE) {
      direction : input;
      signal_type : test_scan_enable;
    }
    pin(D) {
      direction : input;
    }
    pin(CK) {
      direction : input;
    }
    pin(E) {
      direction : input;
    }
    ff(IQ,IQN) {
      clocked_on : "CK";
      next_state : "(D E) + (!E IQ)";
    }
    pin(Q) {

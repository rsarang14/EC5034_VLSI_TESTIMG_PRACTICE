#! /bin/sh -f
#\
exec tessent -shell -log $0.log -replace -dofile "$0"

# Lab9 Task1: Memory BIST insertion for dtmf_recvr_core (gsclib045 HVT library)

# Set the context to insert DFT into RTL-level design
set_context dft -rtl -design_id rtl1

# Set the location of TSDB. Default is at the current working directory
set_tsdb_output_directory tsdb_outdir

# Read cell library (Lab9 library)
read_cell_library ../../library/standard_cells/tessent/slow_vdd1v0_basicCells_hvt.tcelllib
# Lab7 ADK library (alternative)
#read_cell_library ../../library/standard_cells/tessent/adk.tcelllib

# Read the memory library model
set_design_sources -format tcd_memory -y ../../library/memories -extension tcd_memory

# Read memory verilog model (ram_256x16A, rom_512x16A, pllclk)
read_verilog ../../library/memories/*.v -exclude_from_file_dictionary

# Read the design (.h include dir given by +incdir+ in rtl_file_list)
read_verilog -f rtl_file_list

set_current_design dtmf_recvr_core

# Set the design level as physical_block
set_design_level physical_block

# Specify DFT requirements to insert memory test
set_dft_specification_requirements -memory_test on

# Specify the clocks feeding memories
# Memories are clocked by m_clk / m_ram_clk / m_dsram_clk = clk (PLL clk2x) in functional mode
add_clocks 0 refclk -period 8ns
add_clocks PLLCLK_INST/clk2x -reference refclk -freq_divider 2

# Keep functional clock path selected through TEST_CONTROL_INST muxes
add_input_constraints test_mode -C0

check_design_rules

report_memory_instances

# No ROM content file (romcontent.hex) available, so leave the ROM out of MBIST
set_memory_instance_options ROM_512x16_0_INST -use_in_memory_bist_dft_specification off

# Create and report DFT Specfication that can be modified if necessary
set spec [create_dft_specification]
report_config_data $spec

# Generate and insert the hardware
process_dft_specification

# Extract IJTAG network and create ICL file for the design
extract_icl

write_design_import_script dtmf_recvr_core.dc_design_load_script -use_relative_path_to ../synth -replace -format genus

# Generate patterns to verify the inserted DFT logic
create_pattern_specification
process_pattern_specification

set_simulation_library_sources \
 -v ../../library/gsclib045/slow_vdd1v0_basicCells_hvt.v \
 -v ../../library/memories/*.v
# Lab7 ADK library (alternative)
#set_simulation_library_sources -v ../../library/standard_cells/verilog/adk.v -v ../../library/memories/*.v

# Point to the libraries and run the simulation
# RTL has no `timescale but memory/Tessent modules do -> suppress vsim-3009
run_testbench_simulations -store_simulation_waveforms on -simulator_options "-suppress 3009"

# If simulation fails use the command to see which pattern failed
#check_testbench_simulations -report_status

exit
